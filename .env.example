# ── Motor de facturación (Feature 1) · Arquitectura "Opción A" ──
# El PDF se genera desde el layout de la app (Chromium) y, si estas credenciales
# están cargadas, se sube a Drive y se registra en Supabase.
# Copiar a .env.local y rellenar. NO commitear .env.local.

# ── Google OAuth (subida del PDF a Drive) ──
# Proyecto Google Cloud propio (hoy: cuenta de Guillermo / org nexumai.online).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token: se obtiene UNA vez autorizando el flujo de consentimiento
# (OAuth Playground → usar el Client ID/Secret propios → scope drive.file).
GOOGLE_OAUTH_REFRESH_TOKEN=
# Carpeta de Drive donde se guardan los PDF (su ID, lo que va tras /folders/).
DRIVE_FOLDER_ID=

# ── Supabase (registro/índice de facturas) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── PDF en dev local (opcional) ──
# Ruta al Chrome instalado, para el motor PDF en local. En Vercel se ignora
# (allí se usa @sparticuz/chromium automáticamente).
LOCAL_CHROME_PATH=
