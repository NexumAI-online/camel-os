# Copiar a .env.local (local) y cargar las mismas variables en Vercel → Settings → Environment Variables.
# NUNCA commitear .env.local. Ver README.md para saber de dónde sale cada valor.

# ── Supabase (OBLIGATORIO: base de datos + Storage de todo el panel) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Login del panel (OBLIGATORIO) ──
# Usuario/contraseña únicos del panel; AUTH_SECRET firma la cookie de sesión
# (cadena larga aleatoria; si se cambia, se cierran todas las sesiones).
APP_USER=
APP_PASSWORD=
AUTH_SECRET=

# ── Buscador (Dubizzle y YallaMotor corren por Apify; Dubicars no necesita nada) ──
APIFY_TOKEN=

# ── Keep-alive de Supabase (opcional) ──
# Si se define, /api/keep-alive exige "Authorization: Bearer <CRON_SECRET>" (Vercel Cron lo envía solo).
CRON_SECRET=

# ── Solo desarrollo local: ruta al Chrome instalado para generar el PDF ──
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# En Vercel se ignora (usa @sparticuz/chromium).
LOCAL_CHROME_PATH=

# ── LEGACY · Google Drive (solo para abrir PDFs viejos guardados en Drive) ──
# Las facturas nuevas se guardan en Supabase Storage. Estas 4 variables solo hacen falta
# si en la tabla `facturas` quedan filas cuyo drive_url empieza con http (PDFs antiguos en Drive).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
